{
  "name": "evolve-agent-desktop",
  "version": "1.2.0",
  "description": "Evolve Agent 桌面端启动器 — 配置管理 + 后端生命周期 + WebView",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "runtime:lock": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-runtime-assets.ps1 -RefreshLock",
    "prepare:runtime": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-runtime-assets.ps1",
    "prepare:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-runtime-assets.ps1 -StageDev",
    "prepare:frontend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-frontend.ps1 -ConfigKey default",
    "build": "set CSC_IDENTITY_AUTO_DISCOVERY=false&& pnpm run prepare:runtime && pnpm run prepare:frontend && electron-builder --win --x64",
    "postinstall": "electron-builder install-app-deps"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["electron", "electron-builder"]
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}