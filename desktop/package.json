{
  "name": "evolve-agent-desktop",
  "version": "1.0.0",
  "description": "Evolve Agent 桌面端启动器 — 配置管理 + 后端生命周期 + WebView",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "prepare-embed": "powershell -ExecutionPolicy Bypass -File scripts/prepare-embed-python.ps1 -ConfigKey default",
    "build": "set CSC_IDENTITY_AUTO_DISCOVERY=false&& pnpm run prepare-embed && electron-builder --win",
    "postinstall": "electron-builder install-app-deps"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["electron", "electron-builder"]
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}