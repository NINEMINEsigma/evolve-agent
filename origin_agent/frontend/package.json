    "mermaid": "^11.6.0",
    "monaco-editor": "^0.55.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-joyride": "^3.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.0",
    "react-syntax-highlighter": "^16.1.1",
    "react18-json-view": "^0.2.7",
    "react-zoom-pan-pinch": "^3.7.0",
    "rehype-raw": "^7.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
