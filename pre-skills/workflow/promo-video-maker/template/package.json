{
  "name": "promo-video-maker-project",
  "version": "1.0.0-localized",
  "private": true,
  "license": "MIT",
  "dependencies": {
    "@remotion/bundler": "4.0.529",
    "@remotion/cli": "4.0.529",
    "@remotion/fonts": "4.0.529",
    "@remotion/google-fonts": "4.0.529",
    "@remotion/light-leaks": "4.0.529",
    "@remotion/media": "4.0.529",
    "@remotion/motion-blur": "4.0.529",
    "@remotion/noise": "4.0.529",
    "@remotion/paths": "4.0.529",
    "@remotion/player": "4.0.529",
    "@remotion/renderer": "4.0.529",
    "@remotion/shapes": "4.0.529",
    "@remotion/tailwind-v4": "4.0.529",
    "@remotion/transitions": "4.0.529",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.529",
    "tailwindcss": "4.0.0"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.529",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/web": "0.0.166",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "vite": "6.4.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "lint": "eslint src && tsc && tsc -p tsconfig.web.json",
    "web": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "web:serve": "node scripts/serve.mjs",
    "mix": "python scripts/mix.py",
    "fonts": "python scripts/fonts.py",
    "stills": "node scripts/stills.mjs",
    "sheet": "python scripts/sheet.py",
    "srt": "python scripts/srt.py",
    "check:assets": "python scripts/check_assets.py",
    "test:content": "node scripts/content-check.mjs",
    "render:preview": "node scripts/render.mjs --preview",
    "render:1080": "node scripts/render.mjs --scale=1",
    "render:4k": "node scripts/render.mjs --scale=2",
    "validate:video": "python scripts/validate-video.py"
  },
  "sideEffects": ["*.css", "./src/lib/fonts.ts"]
}
